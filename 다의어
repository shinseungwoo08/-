        function searchWord() {
            let input = document.getElementById('searchInput').value.toLowerCase();
            let resultDiv = document.getElementById('result');
            resultDiv.innerHTML = "";
            if (input === "") return;
            let filtered = wordData.filter(item => item.word.toLowerCase().includes(input));
            filtered.forEach(item => {
                resultDiv.innerHTML += `<div class="card"><strong>${item.word}</strong> (${item.main_cat}${item.sub_cat ? ' > ' + item.sub_cat : ''})<br>${item.meaning}</div>`;
            });
        }
